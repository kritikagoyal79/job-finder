{
  "_readme": "Copy this file to config.europe.json (same directory) and fill in your own values. config.europe.json is gitignored since it holds machine-specific paths and personal search preferences. Locations here also cover Japan-based roles, which use the same EU resume/answers per prior convention.",

  "search": {
    "_readme": "titles is now a fallback only -- the skill derives search titles from the resume each run and passes them to the script directly. Fill this in with something reasonable anyway in case the resume can't be read for some reason.",
    "titles": ["Software Engineer", "Backend Engineer", "Java Developer"],
    "locations": ["Remote", "Germany", "Netherlands", "Ireland", "Japan"],
    "maxResultsPerLocation": 15
  },

  "matchThresholdPercent": 50,

  "resume": "resume/YourResume_EU.pdf",
  "region": "eu",

  "chrome": {
    "_readme": "A dedicated Chrome profile just for this tool -- NOT your everyday Chrome profile. Log into LinkedIn by hand in this profile once; Playwright will then reuse those cookies on every run.",
    "profileDir": "C:/Users/kriti/AppData/Local/JobFinderChromeProfile"
  }
}
